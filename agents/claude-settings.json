{
  "permissions": {
    "allow": [
      "Read(~/dotfiles/agents/**)"
    ]
  },
  "includeCoAuthoredBy": false,
  "model": "opus",
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true
  },
  "tui": "fullscreen",
  "agentPushNotifEnabled": true,
  "effortLevel": "medium",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dotfiles/agents/rename_branch.sh\"",
            "statusMessage": "Checking branch name"
          }
        ]
      }
    ]
  }
}
